# ---------------------------------------------------------------------------
# Discord bot credentials
# ---------------------------------------------------------------------------
# Developer Portal -> your application -> Bot -> Reset Token.
# Never commit the real token.
DISCORD_TOKEN=

# ---------------------------------------------------------------------------
# What to watch
# ---------------------------------------------------------------------------
# Server (guild) and role that should trigger a notification.
GUILD_ID=1499114258007588914
ROLE_ID=1555015410112270458

# ---------------------------------------------------------------------------
# Admin log
# ---------------------------------------------------------------------------
# Every welcome DM posts a short embedded audit entry in this channel: who was messaged,
# which role triggered it, and whether delivery succeeded.
#
# The dashboard can change this at runtime; that stored value wins over .env.
# Leave empty to disable channel logging.
LOG_CHANNEL_ID=1499140628817379459

# ---------------------------------------------------------------------------
# What to say
# ---------------------------------------------------------------------------
# Text sent above the embed. Out of the box this is the multi-line welcome
# message in templates/welcome.md.
#
# Placeholders are substituted where they appear:
#   {user} {username} {displayName} {server} {role} {roleName}
#   {memberCount} {assignedBy} {userId}
#
# Set this to a literal one-liner to override the file. Setting it to an empty
# value sends only the embed.
#MESSAGE_TEMPLATE=

# Optional: the file to read the message from. Defaults to
# templates/welcome.md, so you normally do not need to set it.
# Set it explicitly to use a different file. The path is relative to the project
# directory, and the file is re-read on every notification, so edits take
# effect without a restart.
#MESSAGE_TEMPLATE_FILE=templates/welcome.md

# Include the details embed (role, assigner, account age) after the text.
# Set to false if your message should stand alone.
EMBED_ENABLED=true

EMBED_TITLE=Role assigned
EMBED_COLOR=#57F287

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Skip role changes that happen to bot accounts.
IGNORE_BOTS=true

# Look up who assigned the role in the server audit log.
# Requires the "View Audit Log" permission; falls back silently if missing.
LOOKUP_AUDIT_LOG=true

# Log what would happen without sending anything (good for a first run).
DRY_RUN=false

# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web dashboard (optional)
# ---------------------------------------------------------------------------
# Serves a small dashboard where a server admin can pick the welcome role,
# edit the welcome message and watch the bot's activity log.
# Login uses Discord OAuth2; only members with "Manage Server" (or the owner)
# can sign in.
#
# Setup:
#   1. Developer Portal -> your app -> OAuth2 -> copy the Client Secret.
#   2. Add this redirect URI there: http://localhost:3000/auth/callback
#   3. Set DISCORD_CLIENT_SECRET below and restart the bot.
#   4. Open http://localhost:3000 (on a server: ssh -L 3000:localhost:3000 ...)
WEB_ENABLED=false

# Bind address. Keep 127.0.0.1 for both an SSH tunnel and a reverse proxy on the
# same machine (Caddy, nginx) -- the proxy dials loopback, so the bot itself
# never has to accept a connection from the network. Use 0.0.0.0 only when the
# proxy runs on a different host, and only with a login configured.
WEB_HOST=127.0.0.1
WEB_PORT=3000

# Application (client) ID. Optional: defaults to the bot's own user ID.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match the redirect URI registered in the Developer Portal.
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# How long a dashboard login stays valid, in hours (1-168).
SESSION_TTL_HOURS=12

# Optional: extra Discord user IDs allowed in even without Manage Server.
# Comma-separated.
WEB_ADMIN_IDS=

# Must be true whenever OAUTH_REDIRECT_URI is https://, so the session cookie is
# never sent over a plain-HTTP connection.
WEB_COOKIE_SECURE=false

